# ============================================================================
# Chatbot WhatsApp Mob2Con — configuração
# ----------------------------------------------------------------------------
# NÃO edite este arquivo com segredos reais. Rode:
#     python scripts/gerar_env.py
# Ele cria o .env com chaves aleatórias.
# ============================================================================

# ---------------------------------------------------------------- Evolution API
# Do host (scripts, navegador): http://localhost:8080
# De dentro do Docker o compose sobrescreve para http://evolution-api:8080
EVOLUTION_URL=http://localhost:8080

# Chave global da Evolution. gerar_env.py substitui por um valor aleatório.
# NUNCA use a chave de exemplo pública do repositório oficial.
EVOLUTION_API_KEY=TROQUE-ME

# Nome da instância (um número de WhatsApp por instância)
EVOLUTION_INSTANCIA=mob2con

# Token específico da instância. Opcional: se vazio, usa a chave global.
EVOLUTION_TOKEN_INSTANCIA=

EVOLUTION_TIMEOUT=30

# ---------------------------------------------------------------- Bot
PORTA=8000
NIVEL_LOG=INFO

# Token exigido no header X-Webhook-Token. gerar_env.py preenche.
# Deixe vazio somente se a Evolution e o bot estiverem na mesma rede fechada.
WEBHOOK_TOKEN=

# Caminho do arquivo de fluxo. Vazio = bot/fluxo.json
#   bot/fluxo.json          atendimento de BI e Power BI (dashboards, automação)
#   bot/fluxo-mob2con.json  atendimento Mob2Con (acesso, cadastro, MobConnect)
# Rode 'python verificar-fluxo-mob2con.py' depois de trocar.
CAMINHO_FLUXO=bot/fluxo-mob2con.json

# Sessões no Redis (opcional para múltiplas réplicas).
# No Docker: redis://redis:6379/1. Quando preenchido, tem prioridade.
REDIS_URL=

# Banco local usado para sessões e perguntas não respondidas.
# Caminho relativo parte da raiz do projeto.
SQLITE_PATH=dados/chatbot.sqlite3


# ------------------------------------------------------ Manuais locais (FTS5)
# Busca extrativa sem chave de IA. Aponte para a pasta com os 60 arquivos .md.
# Caminho relativo parte da raiz do projeto; caminho absoluto também funciona.
MANUAIS_ATIVO=true
MANUAIS_DIRETORIO=knowledge/mob2con/docs
MANUAIS_INDICE=dados/manuais.sqlite3
MANUAIS_MAX_RESULTADOS=2
MANUAIS_MAX_CARACTERES=1200

# ---------------------------------------------------------------- Atendimento
NOME_EMPRESA=Mob2Con
FUSO_HORARIO=America/Sao_Paulo
HORA_ABERTURA=08:00
# O time humano da Mob2Con atende até as 17h. O bot responde 24h.
HORA_FECHAMENTO=17:00
# 0=segunda ... 6=domingo
DIAS_UTEIS=0,1,2,3,4

# Minutos de inatividade até a conversa reiniciar no menu
MINUTOS_SESSAO=30

# Minutos em que o bot fica calado após transferir para um humano
MINUTOS_PAUSA_HUMANO=60

# Tentativas inválidas antes de transferir para atendente
MAX_TENTATIVAS_INVALIDAS=3

# Responder em grupos? Mantenha false: grupo com bot é fonte de ruído e ban.
RESPONDER_GRUPOS=false

# Pausa de "digitando..." antes de cada mensagem (ms). 0 desliga.
DELAY_DIGITANDO_MS=1200

# Números que o bot nunca responde (só dígitos, separados por vírgula)
NUMEROS_BLOQUEADOS=

# Modo teste: se preenchido, o bot SÓ responde estes números.
# Use o seu número aqui enquanto valida o fluxo.
NUMEROS_PERMITIDOS=

# Responsável geral: recebe casos sem frente ou sem destino próprio.
NUMERO_NOTIFICACAO=

# Enquanto true, todo aviso cai no responsável geral e apenas informa o
# destino de produção. Troque para false somente após alinhar com as frentes.
NOTIFICACAO_MODO_TESTE=true

# Destinos de produção por frente. Use somente canais autorizados.
NOTIFICACAO_SUPORTE=
NOTIFICACAO_FINANCEIRO=
NOTIFICACAO_COMERCIAL_INDUSTRIA=
NOTIFICACAO_COMERCIAL_VAREJO=
# Contato direto do responsável MobConnect não é público; vazio cai no geral.
NOTIFICACAO_COMERCIAL_MOBCONNECT=

# ---------------------------------------------------------------- IA (opcional)
# Com LLM_ATIVO=false o bot é 100% menu — determinístico e sem custo.
LLM_ATIVO=false

# OpenAI:      https://api.openai.com/v1
# NVIDIA NIM:  https://integrate.api.nvidia.com/v1
# Groq:        https://api.groq.com/openai/v1
# Ollama:      http://host.docker.internal:11434/v1
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODELO=gpt-4o-mini
LLM_MAX_TOKENS=300
LLM_TEMPERATURA=0.3
LLM_TIMEOUT=25
# Teto para modelo local lento; se exceder, o bot cai para fluxo/RAG sem travar o WhatsApp.
LLM_TIMEOUT_LOCAL=12
LLM_MAX_HISTORICO=6

# Prompt de sistema da IA. Uma base de conhecimento não cabe numa linha de .env,
# então aponte para um arquivo — ele tem precedência sobre LLM_PROMPT_SISTEMA.
# Caminho relativo é resolvido a partir da raiz do projeto. Comentários HTML
# (<!-- ... -->) são removidos antes de virar prompt.
LLM_PROMPT_ARQUIVO=bot/conhecimento-mob2con.md

# Alternativa em linha única, usada só se LLM_PROMPT_ARQUIVO estiver vazio
# ou apontar para arquivo inexistente.
LLM_PROMPT_SISTEMA=

# ---------------------------------------------------------------- Postgres (só Docker)
POSTGRES_USER=evolution
POSTGRES_PASSWORD=TROQUE-ME
POSTGRES_DB=evolution

# ---------------------------------------------------------------- Gateway (só modo sem Docker)
# Usado apenas pelo gateway/ em Node, que substitui a Evolution API.
# Ele reaproveita EVOLUTION_API_KEY, EVOLUTION_INSTANCIA e WEBHOOK_TOKEN acima.
GATEWAY_PORTA=8080
GATEWAY_WEBHOOK_URL=http://localhost:8000/webhook
GATEWAY_SESSAO_DIR=sessao
GATEWAY_NIVEL_LOG=info
