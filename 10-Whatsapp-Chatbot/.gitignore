# Volumes locais do Docker
docker-volumes/

# Python
__pycache__/
*.pyc
.venv/

# Logs — podem conter números e conteúdo de atendimento
*.log
*.log.*
logs/


# Persistência local — pode conter contexto de conversa
/dados/
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
