table Métricas
	lineageTag: 72ffdf83-60a2-4130-8854-bda09c1fd07b
	sourceLineageTag: fc56e519-cdec-4371-a3f8-8992e3606c82

	/// Lojas no projeto respondendo aos filtros de rede da página. Dados embutidos no DAX para compatibilidade com o serviço online.
	measure 'Lojas no Projeto (Filtro)' =
			VAR _base =
			    DATATABLE(
			        "nm_rede", STRING,
			        "qtd_lojas", INTEGER,
			        {
			            { "GBARBOSA",    69 },
			            { "PREZUNIC",    39 },
			            { "BIGBOX",      34 },
			            { "NOVA ERA",    28 },
			            { "NORDESTAO",   20 },
			            { "PAGUE MENOS",  1 }
			        }
			    )
			VAR _redes_selecionadas =
			    CALCULATETABLE(
			        VALUES(dim_rede[nm_rede]),
			        CROSSFILTER('tb_Dashboard estudo RG'[REDE ATENDIDA], dim_rede[nm_rede], BOTH)
			    )
			RETURN
			    SUMX(
			        FILTER(_base, [nm_rede] IN _redes_selecionadas),
			        [qtd_lojas]
			    )
		formatString: 0
		displayFolder: Cadastro / Acesso
		lineageTag: 64a31c41-5969-4003-8b19-39aa6564d054

