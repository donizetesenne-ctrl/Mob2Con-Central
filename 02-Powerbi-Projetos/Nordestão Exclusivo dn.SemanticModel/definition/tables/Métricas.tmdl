	measure 'Venda (Qtd.) M-1' = EXTERNALMEASURE("Venda (Qtd.) M-1", DOUBLE, "DirectQuery para AS – Base Indicadores RG 2.0 - Projetos")
		formatString: #,0
		displayFolder: Sell Out
