		dataCategory: Uncategorized

	measure 'Estoque (Qtd.) Última Posição Mês (M-1) Projeto' = EXTERNALMEASURE("Estoque (Qtd.) Última Posição Mês (M-1) Projeto", DOUBLE, "DirectQuery para AS – Base Indicadores RG 2.0 - Projetos")
		formatString: #,0
		displayFolder: Sell Out
