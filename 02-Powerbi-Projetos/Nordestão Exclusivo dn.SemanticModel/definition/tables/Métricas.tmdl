	measure 'Qtd Produto Com estoque Sem Vendas M-1' = EXTERNALMEASURE("Qtd Produto Com estoque Sem Vendas M-1", INTEGER, "DirectQuery para AS – Base Indicadores RG 2.0 - Projetos")
		formatString: #,0
		displayFolder: Sell Out
