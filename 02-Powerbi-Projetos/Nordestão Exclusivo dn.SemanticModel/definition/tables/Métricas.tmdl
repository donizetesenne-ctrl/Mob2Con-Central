	/// Horas Ideais para gauge de eficiência
	measure 'NE | Horas Ideais (Gauge)' = [NE | Horas Ideais]
		displayFolder: 08 - Visuais Apoio
		lineageTag: b4afa2c4-7e76-42fb-871e-9c3ae168b242

	/// Meta 100% para gauge de visitas
	measure 'NE | Meta 100%' = 1
		displayFolder: 08 - Visuais Apoio
		lineageTag: 244cf067-5e69-41ba-be5e-ed930b8849d7

	/// Meta 80% para gauge de produtividade
	measure 'NE | Meta 80%' = 0.8
		displayFolder: 08 - Visuais Apoio
		lineageTag: e52c619e-d6f3-4102-8b49-d1867ea69025

	/// Valor atual para gauge de eficiência de horas (0-1)
	measure 'NE | Gauge - % Eficiência Horas' = [NE | % Eficiência Horas]
		formatString: 0.0%
		displayFolder: 08 - Visuais Apoio
		lineageTag: 243955ac-82d7-48c6-bdaf-69c54614c6d2

	/// Valor atual para gauge de execução de visitas (0-1)
	measure 'NE | Gauge - % Execução Visitas' = [NE | % Execução Visitas]
		formatString: 0.0%
		displayFolder: 08 - Visuais Apoio
		lineageTag: 63d3d412-bba7-4e45-8cc2-412290727385

	/// Valor atual para gauge de tarefas concluídas (0-1)
	measure 'NE | Gauge - % Tarefas Concluídas' = [NE | % Tarefas Concluídas]
		formatString: 0.0%
		displayFolder: 08 - Visuais Apoio
		lineageTag: 9c76de34-fcd6-47d2-ac20-39a419acba5c

	/// Valor atual para gauge de cobertura de lojas (0-1)
	measure 'NE | Gauge - % Cobertura Lojas' = [NE | % Cobertura Lojas]
		formatString: 0.0%
		displayFolder: 08 - Visuais Apoio
		lineageTag: 91a60193-398f-4be8-a887-23847dc1af00

	/// Label formatado do score de saúde operacional
	measure 'NE | Label Score Saúde' = FORMAT([NE | Score Saúde Operacional], "0.0") & " / 100 — " & [NE | Faixa Saúde Operacional]
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 49b063f0-a7a1-46d0-a550-3a68ecebad89

	/// Label consolidado de ruptura total com semáforo
	measure 'NE | Label Ruptura Total' = [NE | Semáforo Ruptura Op] & "  Ruptura Op: " & FORMAT([NE | % Ruptura Operacional], "0.0%") & "  |  Comercial: " & FORMAT([NE | % Ruptura Comercial], "0.0%")
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 61c672ca-c34c-45ad-84f0-2e7fabe7e346

	/// Label de variação MoM com ícone de tendência
	measure 'MoM %' = VAR v = [NE | Variação Vendas MoM] RETURN IF(ISBLANK(v), "—", IF(v >= 0, "▲ " & FORMAT(v, "0.0%"), "▼ " & FORMAT(ABS(v), "0.0%")))
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: c2e00bd2-3c39-4f80-af2c-7cd8797c0884

	/// % ruptura operacional sobre venda M-1 para uso em gauge
	measure 'NE | % Ruptura Op sobre Venda' = DIVIDE([NE | Ruptura Operacional (R$)], [Venda M-1])
		formatString: 0.0%
		displayFolder: 08 - Visuais Apoio
		lineageTag: a0b50e39-311c-4bce-8346-eec4c0f73283

	/// Receita total em risco (ruptura op + com + adm)
	measure 'NE | Receita em Risco Total' = [NE | Ruptura Total (R$)]
		formatString: R$ #,##0
		displayFolder: 08 - Visuais Apoio
		lineageTag: 4fdfa879-032f-4dde-be86-c699e00e2fae

	/// Promotores com acesso e com atividades no período
	measure 'NE | KPI Promotores Ativos' = VAR comAcesso = [NE | Promotores com Acesso] VAR comAtiv = [NE | Atividades (Qtd)] RETURN comAcesso
		formatString: #,##0
		displayFolder: 08 - Visuais Apoio
		lineageTag: 0f87a3f9-b19e-4d68-ab07-82f540b1694c

	/// Total de produtos com algum problema de estoque (zero + negativo + avariado + fora validade)
	measure 'NE | Total Produtos Problema' = VAR zero = [NE | Produtos Estoque Zero] VAR neg = [NE | Produtos Estoque Negativo] VAR avar = [NE | Produto Avariado] VAR val = [NE | Fora de Validade] RETURN zero + neg + avar + val
		formatString: #,##0
		displayFolder: 08 - Visuais Apoio
		lineageTag: ba09e4a1-e71d-4a55-9ce3-3f7095d46315

	/// Card resumo de estoque para visual de texto
	measure 'NE | Card Resumo Estoque' = "DDE: " & FORMAT([NE | Dias de Estoque (DDE)], "0.0") & " dias  |  Estoque Zero: " & FORMAT([NE | Produtos Estoque Zero], "#,##0") & "  |  Negativo: " & FORMAT([NE | Produtos Estoque Negativo], "#,##0")
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 6469325b-7dfb-4220-be8f-e030054cf2ab

	/// Classifica DDE em faixas de alerta
	measure 'NE | Semaforo DDE' = VAR dde = [NE | Dias de Estoque (DDE)] RETURN SWITCH(TRUE(), ISBLANK(dde), "—", dde <= 7, "🔴 Crítico (≤ 7 dias)", dde <= 15, "🟡 Atenção (8-15 dias)", "🟢 Adequado (> 15 dias)")
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 3e40eb28-803f-454d-ad59-48ced42e67be

	/// Score de produtividade formatado com faixa
	measure 'NE | Label Score Produtividade' = FORMAT([NE | Prod - Score Produtividade], "0.0") & " / 100 — " & [NE | Prod - Faixa Produtividade]
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 00f37c59-cabb-48eb-962b-ce512edfd19d

	/// Resumo de impacto financeiro da produtividade
	measure 'NE | Card Impacto Financeiro Prod' = "ROI/hora: " & FORMAT([NE | Sim - ROI por Hora de Promotor], "R$ #,##0") & "  |  Pot. Meta 80%: " & FORMAT([NE | Sim - Impacto Financeiro Meta 80%], "R$ #,##0") & "  |  Pot. Meta 100%: " & FORMAT([NE | Sim - Impacto Financeiro Meta 100%], "R$ #,##0")
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: f8306bc9-e238-469a-86bf-c6f7eafaf4a3

	/// Resumo do contexto de feriados para card
	measure 'NE | Card Contexto Feriados' = "Feriados no mês: " & FORMAT([NE | Fer - Feriados no Mês], "#,##0") & "  |  Dias úteis: " & FORMAT([NE | Fer - Dias Úteis no Mês], "#,##0") & "  |  Score Ajustado: " & FORMAT([NE | Fer - Score Produtividade Ajustado], "0.0")
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 8ba257b7-45b3-4d8c-ba90-2bdbdb1ba968

	/// Diferença entre score ajustado e original com sinal
	measure 'NE | Label Impacto Feriado Score' = VAR impacto = [NE | Fer - Impacto Feriado no Score] RETURN IF(ISBLANK(impacto), "—", IF(impacto >= 0, "+" & FORMAT(impacto, "0.0") & " pts", FORMAT(impacto, "0.0") & " pts"))
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: d9676a4b-d42c-4a7f-b075-9e1ae980ebeb

	/// Venda M-1 vs M-2 vs M-3 em uma linha para tooltip
	measure 'NE | Card Evolução Vendas 3M' = "M-1: " & FORMAT([Venda M-1], "R$ #,##0") & "  |  M-2: " & FORMAT([Venda M-2], "R$ #,##0") & "  |  M-3: " & FORMAT([Venda M-3], "R$ #,##0")
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: b98853df-b3f8-42f6-b54b-5a5212216f75

	/// Ruptura Op M-1 vs M-2 vs M-Atual para evolução
	measure 'NE | Card Evolução Ruptura 3M' = "M-1: " & FORMAT([NE | Ruptura Operacional M-1 (R$)], "R$ #,##0") & "  |  M-2: " & FORMAT([NE | Ruptura Operacional M-2 (R$)], "R$ #,##0") & "  |  M-Atual: " & FORMAT([NE | Ruptura Operacional M-Atual (R$)], "R$ #,##0")
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 49cab55f-6ad9-4126-a55c-bb8e569d9c98

	/// Venda por hora trabalhada formatada
	measure 'NE | KPI Venda por Hora' = [NE | Corr - Venda por Hora Trabalhada]
		formatString: R$ #,##0.00
		displayFolder: 08 - Visuais Apoio
		lineageTag: 4d0e2486-ba32-4a11-8cc1-09fcb6f97cd2

	/// Top 10 lojas por ruptura operacional — para tabela de ranking
	measure 'NE | Rank Loja Ruptura (Visual)' = RANKX(ALL(dim_loja[nm_loja]), [NE | Ruptura Operacional (R$)], , DESC, Dense)
		formatString: #,##0
		displayFolder: 08 - Visuais Apoio
		lineageTag: 707fff13-dfa7-43a1-9048-da6ef86840d4

	/// Top promotores por score de produtividade — para tabela de ranking
	measure 'NE | Rank Promotor Score (Visual)' = RANKX(ALL(dim_visitante[nm_visitante_arrumado]), [NE | Prod - Score Produtividade], , DESC, Dense)
		formatString: #,##0
		displayFolder: 08 - Visuais Apoio
		lineageTag: 9cfed827-3f54-4a68-a1e6-6233a153d12a

	/// Top produtos por ruptura operacional — para tabela Pareto
	measure 'NE | Rank Produto Ruptura (Visual)' = RANKX(ALL(dim_produto_rede[ds_produto_rede]), [NE | Ruptura Operacional (R$)], , DESC, Dense)
		formatString: #,##0
		displayFolder: 08 - Visuais Apoio
		lineageTag: 3be02073-af55-40d1-ad3a-1596bd347fb8

	/// Venda M-1 formatada em R$ milhões para KPI card
	measure 'NE | KPI Venda M-1 Label' = VAR v = [Venda M-1] RETURN IF(ISBLANK(v), "—", IF(v >= 1000000, FORMAT(v/1000000, "R$ #,##0.0") & "M", FORMAT(v, "R$ #,##0")))
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: be603575-560e-4f0f-8806-c356283597c1

	/// Ruptura total formatada em R$ milhões para KPI card
	measure 'NE | KPI Ruptura Total Label' = VAR v = [NE | Ruptura Total (R$)] RETURN IF(ISBLANK(v), "—", IF(v >= 1000000, FORMAT(v/1000000, "R$ #,##0.0") & "M", FORMAT(v, "R$ #,##0")))
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 6d6df3ab-f2c8-4050-bc21-35285e6cc97f

	/// Score saúde operacional normalizado 0-1 para gauge
	measure 'NE | Gauge Score Saúde' = DIVIDE([NE | Score Saúde Operacional], 100)
		formatString: 0.0%
		displayFolder: 08 - Visuais Apoio
		lineageTag: 97630fb6-3e0f-4082-a480-a3f9a542b124

	/// Score produtividade normalizado 0-1 para gauge
	measure 'NE | Gauge Score Produtividade' = DIVIDE([NE | Prod - Score Produtividade], 100)
		formatString: 0.0%
		displayFolder: 08 - Visuais Apoio
		lineageTag: 0179574e-4ab6-44c7-8190-4ebac9a79b5f

	/// % ruptura operacional para gauge (0-1)
	measure 'NE | Gauge % Ruptura Op' = [NE | % Ruptura Operacional]
		formatString: 0.0%
		displayFolder: 08 - Visuais Apoio
		lineageTag: ea8f11d9-99bb-4dcc-92c7-c303a60cfce5

	/// Variação YoY formatada com ícone
	measure 'YoY %' = VAR v = [NE | Variação Vendas YoY] RETURN IF(ISBLANK(v), "—", IF(v >= 0, "▲ " & FORMAT(v, "0.0%"), "▼ " & FORMAT(ABS(v), "0.0%")))
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 4ae0334c-6688-464a-9ed8-e14221371de2

	/// Forecast ruptura próximo mês formatado
	measure 'NE | Forecast Ruptura Label' = VAR v = [NE | Forecast Ruptura Op Próx. Mês] RETURN IF(ISBLANK(v), "—", FORMAT(v, "R$ #,##0"))
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 09883a3a-d3db-4749-a094-3367d7e246f8

	/// Título dinâmico da página Executivo com data de referência
	measure 'NE | Título Executivo' = "Nordestão Exclusivo — Painel Executivo | Ref.: " & [Data Descrição Mês/Ano M-1]
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 0ec3a2ba-8da1-488a-8e78-5727603f4f38

	/// Título dinâmico da página Vendas
	measure 'NE | Título Vendas' = "Nordestão — Análise de Vendas | " & [Data Descrição Mês/Ano M-1]
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 742091d6-0352-4037-91ee-bb119fea5721

	/// Título dinâmico da página Ruptura
	measure 'NE | Título Ruptura' = "Nordestão — Gestão de Ruptura | " & [Data Descrição Mês/Ano M-1]
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: cd856574-6da1-494d-a36d-7aae86a43ddf

	/// Título dinâmico da página Operação
	measure 'NE | Título Operação' = "Nordestão — Operação de Campo | " & [Data Descrição Mês/Ano M-1]
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: a02f4a3e-70ad-4dbc-b296-d7213f7e0398

	/// Título dinâmico da página Estoque
	measure 'NE | Título Estoque' = "Nordestão — Gestão de Estoque | " & [Data Max Estoque]
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: c62c06a9-46a6-433a-a801-bdae0364620b

	/// Título dinâmico da página Produtividade
	measure 'NE | Título Produtividade' = "Nordestão — Produtividade & Correlações | " & [Data Descrição Mês/Ano M-1]
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: 9303250c-6c20-44ef-b437-ce41a6f76244

	/// Título dinâmico da página Feriados
	measure 'NE | Título Feriados' = "Nordestão — Análise de Feriados Natal/RN | " & [Data Descrição Mês/Ano M-1]
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: aeeb598c-8257-4413-9f0b-9136ed0854bc

	/// % de lojas com venda sobre total no projeto
	measure 'NE | % Lojas com Venda' = DIVIDE([Lojas c/ Venda], [NE | Lojas no Projeto])
		formatString: 0.0%
		displayFolder: 08 - Visuais Apoio
		lineageTag: e9c36ec7-fd2a-4ca0-bab0-8d0ab5152beb

	/// % de lojas sem venda sobre total no projeto
	measure 'NE | % Lojas sem Venda' = DIVIDE([Lojas s/ Venda], [NE | Lojas no Projeto])
		formatString: 0.0%
		displayFolder: 08 - Visuais Apoio
		lineageTag: fa5aab15-261f-4092-84e9-e6219562ad74

	/// Receita recuperável formatada em R$ milhões
	measure 'NE | KPI Receita Recuperável Label' = VAR v = [NE | Receita Recuperável Total] RETURN IF(ISBLANK(v), "—", IF(v >= 1000000, FORMAT(v/1000000, "R$ #,##0.0") & "M", FORMAT(v, "R$ #,##0")))
		formatString: @
		displayFolder: 08 - Visuais Apoio
		lineageTag: e11b88fc-0eaf-4ede-b621-f7905f760091

