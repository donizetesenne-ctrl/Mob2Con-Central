table Métricas
	lineageTag: fc56e519-cdec-4371-a3f8-8992e3606c82
	sourceLineageTag: dcba25b8-646d-4400-9cf5-932382554096

	/// Venda total em R$ filtrada para a rede NORDESTAO.
	measure 'NE | Venda (R$)' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_venda_total]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: "R$" #,0.00
		displayFolder: 01 - Vendas
		lineageTag: 60122dbd-88f7-4cc5-8d01-3b126af8cf2d

	/// Venda R$ M-1 Nordestão.
	measure 'Venda M-1' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_venda_total]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    DATEADD('Date'[dt_referencia], -1, MONTH)
			)
		formatString: "R$" #,0.00
		displayFolder: 01 - Vendas
		lineageTag: 85aa14bc-e07b-48ad-993e-a16dbe8a5e50

	/// Venda R$ M-2 Nordestão.
	measure 'Venda M-2' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_venda_total]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    DATEADD('Date'[dt_referencia], -2, MONTH)
			)
		formatString: "R$" #,0.00
		displayFolder: 01 - Vendas
		lineageTag: ce15ff3d-633e-49a7-aa5a-efe201707a37

	/// Venda R$ M-3 Nordestão.
	measure 'Venda M-3' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_venda_total]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    DATEADD('Date'[dt_referencia], -3, MONTH)
			)
		formatString: "R$" #,0.00
		displayFolder: 01 - Vendas
		lineageTag: e78856fd-8f78-4842-b24b-c6cd75385778

	/// Venda R$ mês atual Nordestão.
	measure 'NE | Venda (R$) M-Atual' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_venda_total]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    DATESMTD('Date'[dt_referencia])
			)
		formatString: "R$" #,0.00
		displayFolder: 01 - Vendas
		lineageTag: 6dcc78a8-ccf8-4451-a9c6-588ac5ffaaa5

	/// Venda acumulada mês atual Nordestão.
	measure 'NE | Venda Acumulada M-Atual' =
			TOTALMTD(
			    CALCULATE(SUM('fato_mobconnect_movimento'[vl_venda_total]), 'dim_rede'[nm_rede] = "NORDESTAO"),
			    'Date'[dt_referencia]
			)
		formatString: "R$" #,0.00
		displayFolder: 01 - Vendas
		lineageTag: 36366d1f-6ca0-4aa5-9111-afd270f42b3f

	/// Variação percentual de vendas MoM Nordestão.
	measure 'NE | Variação Vendas MoM' =
			DIVIDE(
			    [Venda M-1] - [Venda M-2],
			    [Venda M-2]
			)
		formatString: 0.0%
		displayFolder: 01 - Vendas
		lineageTag: 31b61163-90cc-4469-a592-5f490e6a35b1

	/// Variação percentual de vendas M-2 vs M-3 Nordestão.
	measure 'NE | Variação Vendas M-2 vs M-3' =
			DIVIDE(
			    [Venda M-2] - [Venda M-3],
			    [Venda M-3]
			)
		formatString: 0.0%
		displayFolder: 01 - Vendas
		lineageTag: 2bcab941-5bf5-474c-8ac0-cf7be92331d8

	/// Tendência de vendas Nordestão vs média 3 meses.
	measure 'NE | Tendência Vendas vs Média 3M' =
			VAR _m1 = [Venda M-1]
			VAR _media = DIVIDE([Venda M-1] + [Venda M-2] + [Venda M-3], 3)
			RETURN DIVIDE(_m1 - _media, _media)
		formatString: 0.0%
		displayFolder: 01 - Vendas
		lineageTag: 99c4718a-b7d7-4655-b246-a88d772dacb7

	/// Venda YTD Nordestão.
	measure 'YTD' =
			TOTALYTD(
			    CALCULATE(SUM('fato_mobconnect_movimento'[vl_venda_total]), 'dim_rede'[nm_rede] = "NORDESTAO"),
			    'Date'[dt_referencia]
			)
		formatString: "R$" #,0.00
		displayFolder: 01 - Vendas
		lineageTag: b51e07ca-0188-415e-a13d-b2778a4758a6

	/// Venda média por loja ativa no Nordestão M-1.
	measure 'Venda / Loja' =
			DIVIDE(
			    [Venda M-1],
			    CALCULATE(DISTINCTCOUNT('dim_loja'[sk_loja]), 'dim_rede'[nm_rede] = "NORDESTAO")
			)
		formatString: "R$" #,0.00
		displayFolder: 01 - Vendas
		lineageTag: 7982853c-d72c-442c-86d1-f7bceb1dc554

	/// Quantidade vendida M-1 Nordestão.
	measure 'NE | Venda (Qtd.) M-1' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[qt_vendida]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    DATEADD('Date'[dt_referencia], -1, MONTH)
			)
		formatString: #,0
		displayFolder: 01 - Vendas
		lineageTag: d2db3877-c87c-4760-b854-a1d280bff8cd

	/// Lojas com venda M-1 no Nordestão.
	measure 'Lojas c/ Venda' =
			CALCULATE(
			    DISTINCTCOUNT('fato_mobconnect_movimento'[sk_loja]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    DATEADD('Date'[dt_referencia], -1, MONTH),
			    'fato_mobconnect_movimento'[qt_vendida] > 0
			)
		formatString: 0
		displayFolder: 01 - Vendas
		lineageTag: a36ab08a-a33a-4015-87bb-7e5f029e910d

	/// Lojas sem venda M-1 no Nordestão.
	measure 'Lojas s/ Venda' =
			VAR _comVenda =
			    CALCULATE(
			        DISTINCTCOUNT('fato_mobconnect_movimento'[sk_loja]),
			        'dim_rede'[nm_rede] = "NORDESTAO",
			        DATEADD('Date'[dt_referencia], -1, MONTH),
			        'fato_mobconnect_movimento'[qt_vendida] > 0
			    )
			VAR _total =
			    CALCULATE(
			        DISTINCTCOUNT('dim_loja'[sk_loja]),
			        'dim_rede'[nm_rede] = "NORDESTAO"
			    )
			RETURN _total - _comVenda
		formatString: 0
		displayFolder: 01 - Vendas
		lineageTag: 4d7d2bd4-117f-4c36-a4b0-2ac70731bc2b

	/// Ícone de tendência de vendas Nordestão.
	measure 'NE | Status Tendência Vendas' =
			VAR _t = [NE | Tendência Vendas vs Média 3M]
			RETURN SWITCH(TRUE(), _t > 0.05, "Crescimento", _t < -0.05, "Queda", "Estavel")
		displayFolder: 01 - Vendas
		lineageTag: 46488a5e-2271-43b7-93b7-44f5c20045e6

	/// Ruptura operacional R$ Nordestão.
	measure 'NE | Ruptura Operacional (R$)' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_ruptura_operacional]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: "R$" #,0.00
		displayFolder: 02 - Ruptura
		lineageTag: 1109d691-3447-4177-a438-34c66596320f

	/// Ruptura comercial R$ Nordestão.
	measure 'NE | Ruptura Comercial (R$)' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_ruptura_comercial]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: "R$" #,0.00
		displayFolder: 02 - Ruptura
		lineageTag: 7d0bc0b7-1c1f-42b9-be09-cae9c4889f98

	/// Ruptura administrativa R$ Nordestão.
	measure 'NE | Ruptura Administrativa (R$)' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_ruptura_administrativa]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: "R$" #,0.00
		displayFolder: 02 - Ruptura
		lineageTag: b44bfeaf-68bf-4450-851a-8d5daa7858ac

	/// Ruptura total (op + com + adm) Nordestão.
	measure 'NE | Ruptura Total (R$)' =
			VAR _op = [NE | Ruptura Operacional (R$)] + 0
			VAR _com = [NE | Ruptura Comercial (R$)] + 0
			VAR _adm = [NE | Ruptura Administrativa (R$)] + 0
			RETURN _op + _com + _adm
		formatString: "R$" #,0.00
		displayFolder: 02 - Ruptura
		lineageTag: ab1c22c2-7a9f-4693-8566-2638dd62e302

	/// % Ruptura operacional sobre venda Nordestão.
	measure 'NE | % Ruptura Operacional' = DIVIDE([NE | Ruptura Operacional (R$)], [NE | Venda (R$)])
		formatString: 0.0%
		displayFolder: 02 - Ruptura
		lineageTag: 36092800-9d82-402a-849a-84c088b8a9c5

	/// % Ruptura comercial sobre venda Nordestão.
	measure 'NE | % Ruptura Comercial' = DIVIDE([NE | Ruptura Comercial (R$)], [NE | Venda (R$)])
		formatString: 0.0%
		displayFolder: 02 - Ruptura
		lineageTag: 2daf37f9-a313-44b4-aebe-7aa37c00dbdf

	/// % Ruptura administrativa sobre venda Nordestão.
	measure 'NE | % Ruptura Administrativa' = DIVIDE([NE | Ruptura Administrativa (R$)], [NE | Venda (R$)])
		formatString: 0.0%
		displayFolder: 02 - Ruptura
		lineageTag: fd000d56-3159-43e6-9709-bba6d3c23f6a

	/// Variação MoM da ruptura operacional Nordestão.
	measure 'NE | Variação Ruptura Op MoM' =
			DIVIDE(
			    [NE | Ruptura Operacional (R$)] - [NE | Ruptura Operacional M-1 (R$)],
			    [NE | Ruptura Operacional M-1 (R$)]
			)
		formatString: 0.0%
		displayFolder: 02 - Ruptura
		lineageTag: 8df84875-5c42-4372-8dae-ec9ffe6242f0

	/// Ruptura operacional M-1 Nordestão.
	measure 'NE | Ruptura Operacional M-1 (R$)' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_ruptura_operacional]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    DATEADD('Date'[dt_referencia], -1, MONTH)
			)
		formatString: "R$" #,0.00
		displayFolder: 02 - Ruptura
		lineageTag: 8c2c7e20-957f-46c0-a846-9bb509e53bc8

	/// Ruptura operacional M-2 Nordestão.
	measure 'NE | Ruptura Operacional M-2 (R$)' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_ruptura_operacional]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    DATEADD('Date'[dt_referencia], -2, MONTH)
			)
		formatString: "R$" #,0.00
		displayFolder: 02 - Ruptura
		lineageTag: 970f28cd-7bd9-49df-b2d7-4d8c5a42fe4d

	/// Ruptura operacional M-Atual Nordestão.
	measure 'NE | Ruptura Operacional M-Atual (R$)' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_ruptura_operacional]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    DATESMTD('Date'[dt_referencia])
			)
		formatString: "R$" #,0.00
		displayFolder: 02 - Ruptura
		lineageTag: cdf5ef03-c0e8-46fb-8ec6-99b4f69da4b8

	/// Receita potencial recuperável com redução de ruptura operacional Nordestão (60% de captura).
	measure 'NE | Receita Recuperável Ruptura Op' = [NE | Ruptura Operacional (R$)] * 0.6
		formatString: "R$" #,0.00
		displayFolder: 02 - Ruptura
		lineageTag: 59660412-ca73-41a9-8205-04ce2f907187

	/// Receita potencial recuperável total (op + com) Nordestão.
	measure 'NE | Receita Recuperável Total' = ([NE | Ruptura Operacional (R$)] + [NE | Ruptura Comercial (R$)]) * 0.6
		formatString: "R$" #,0.00
		displayFolder: 02 - Ruptura
		lineageTag: 517840d7-7220-4f36-bfe8-4b6490c62fc8

	/// Semáforo de ruptura operacional Nordestão.
	measure 'NE | Semáforo Ruptura Op' =
			VAR _pct = [NE | % Ruptura Operacional]
			RETURN SWITCH(TRUE(), _pct <= 0.05, "Verde", _pct <= 0.10, "Amarelo", "Vermelho")
		displayFolder: 02 - Ruptura
		lineageTag: bb8be2d9-2a60-42f6-873b-9ad6fd126a63

	/// Forecast de ruptura operacional para o próximo mês Nordestão.
	measure 'NE | Forecast Ruptura Op Próx. Mês' =
			VAR _m1 = [NE | Ruptura Operacional M-1 (R$)]
			VAR _m2 = [NE | Ruptura Operacional M-2 (R$)]
			VAR _tendencia = _m1 - _m2
			RETURN _m1 + _tendencia
		formatString: "R$" #,0.00
		displayFolder: 02 - Ruptura
		lineageTag: 48837e7b-fb44-4737-8246-c41eb069977a

	/// Produtos com ruptura operacional Nordestão.
	measure 'NE | Produtos Ruptura Operacional' =
			CALCULATE(
			    DISTINCTCOUNT('fato_mobconnect_movimento'[sk_produto_rede]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    'fato_mobconnect_movimento'[qt_ruptura_operacional] > 0
			)
		formatString: 0
		displayFolder: 02 - Ruptura
		lineageTag: 7e0c25e1-c3b5-4481-ab19-555a07ff0f9e

	/// Produtos com ruptura comercial Nordestão.
	measure 'NE | Produtos Ruptura Comercial' =
			CALCULATE(
			    DISTINCTCOUNT('fato_mobconnect_movimento'[sk_produto_rede]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    'fato_mobconnect_movimento'[qt_ruptura_comercial] > 0
			)
		formatString: 0
		displayFolder: 02 - Ruptura
		lineageTag: ef86f7f4-619f-41ce-8f5a-6bcf59dd1c96

	/// Contagem de ruptura total Nordestão.
	measure 'NE | Contagem Ruptura Total' =
			CALCULATE(
			    COUNTROWS('fato_mobconnect_atividades'),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    'dim_mobconnect_tipo_problema'[ds_tipo_problema] = "Ruptura Total"
			)
		formatString: 0
		displayFolder: 02 - Ruptura
		lineageTag: b2716269-3a31-4f6f-b992-ef2e5b069a6f

	/// Contagem de ruptura parcial Nordestão.
	measure 'NE | Contagem Ruptura Parcial' =
			CALCULATE(
			    COUNTROWS('fato_mobconnect_atividades'),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    'dim_mobconnect_tipo_problema'[ds_tipo_problema] = "Ruptura Parcial"
			)
		formatString: 0
		displayFolder: 02 - Ruptura
		lineageTag: 13899345-d47e-4ae8-8972-70b2c59100e9

	/// Ranking de lojas Nordestão por ruptura operacional.
	measure 'NE | Ranking Loja Ruptura Op' =
			RANKX(
			    ALLSELECTED('dim_loja'[nm_loja]),
			    CALCULATE([NE | Ruptura Operacional (R$)], 'dim_rede'[nm_rede] = "NORDESTAO")
			)
		formatString: 0
		displayFolder: 02 - Ruptura
		lineageTag: 6d98139c-7d6f-4340-bcb4-5f44938a265a

	/// Horas ideais contratadas Nordestão.
	measure 'NE | Horas Ideais' =
			CALCULATE(
			    SUM('fato_horas_ideais'[qt_horas_ideais]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0.0
		displayFolder: 03 - Operação
		lineageTag: b9ec14c5-9c89-4c89-b4fb-04e94d86d2d5

	/// Horas realizadas de atendimento Nordestão.
	measure 'NE | Horas Realizadas' =
			CALCULATE(
			    SUM('fato_mobconnect_atendimento_fornecedores'[qt_horas_atendimento]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0.0
		displayFolder: 03 - Operação
		lineageTag: e7f970f9-ff15-4474-a55f-b07043ad4fb9

	/// GAP entre horas realizadas e ideais Nordestão.
	measure 'NE | GAP Horas' = [NE | Horas Realizadas] - [NE | Horas Ideais]
		formatString: 0.0
		displayFolder: 03 - Operação
		lineageTag: 5a64252e-6c79-4330-834e-3b3b4dcccd7f

	/// % Eficiência de horas Nordestão.
	measure 'NE | % Eficiência Horas' = DIVIDE([NE | Horas Realizadas], [NE | Horas Ideais])
		formatString: 0.0%
		displayFolder: 03 - Operação
		lineageTag: 38b075ee-f2e6-47da-888f-1c716879330e

	/// Semáforo de eficiência de horas Nordestão.
	measure 'NE | Semáforo Eficiência Horas' =
			VAR _pct = [NE | % Eficiência Horas]
			RETURN SWITCH(TRUE(), _pct >= 0.95, "Verde", _pct >= 0.80, "Amarelo", "Vermelho")
		displayFolder: 03 - Operação
		lineageTag: f6710087-dd17-4963-b68a-5ccec5abb289

	/// Visitas planejadas Nordestão.
	measure 'NE | Visitas Planejadas' =
			CALCULATE(
			    SUM('fato_mobconnect_visitas'[qt_visitas_planejadas]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0
		displayFolder: 03 - Operação
		lineageTag: 6210d5d4-f34f-483c-96c9-b8e66b1b8262

	/// Visitas realizadas Nordestão.
	measure 'NE | Visitas Realizadas' =
			CALCULATE(
			    SUM('fato_mobconnect_visitas'[qt_visitas_realizadas]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0
		displayFolder: 03 - Operação
		lineageTag: befee412-d7e6-49b1-a030-3e180e4a67e8

	/// % Execução de visitas Nordestão.
	measure 'NE | % Execução Visitas' = DIVIDE([NE | Visitas Realizadas], [NE | Visitas Planejadas])
		formatString: 0.0%
		displayFolder: 03 - Operação
		lineageTag: c48f3b1b-287e-4c80-a417-0598e535c768

	/// GAP de visitas Nordestão.
	measure 'NE | GAP Visitas' = [NE | Visitas Realizadas] - [NE | Visitas Planejadas]
		formatString: 0
		displayFolder: 03 - Operação
		lineageTag: cc522a7b-3f65-4890-abe2-72fca3b20a5c

	/// Total de atividades MobConnect Nordestão.
	measure 'NE | Atividades (Qtd)' =
			CALCULATE(
			    SUM('fato_mobconnect_atividades'[qt_atividades]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0
		displayFolder: 03 - Operação
		lineageTag: 2c6b2db6-68e2-4b63-b109-5d8b93019207

	/// Tarefas concluídas Nordestão.
	measure 'NE | Tarefas Concluídas' =
			CALCULATE(
			    COUNTROWS('fato_mobconnect_atividades'),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    'dim_mobconnect_status_atividade'[ds_status_atividade] = "Concluida"
			)
		formatString: 0
		displayFolder: 03 - Operação
		lineageTag: d5a84faf-c388-4fac-b911-1b0b6c163895

	/// Atividades com problema reportado Nordestão.
	measure 'NE | Atividades Problema' =
			CALCULATE(
			    COUNTROWS('fato_mobconnect_atividades'),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    NOT ISBLANK('fato_mobconnect_atividades'[sk_mobconnect_tipo_problema])
			)
		formatString: 0
		displayFolder: 03 - Operação
		lineageTag: 7aae4914-1483-46e3-9db9-69ac92263df6

	/// % Tarefas concluídas Nordestão.
	measure 'NE | % Tarefas Concluídas' = DIVIDE([NE | Tarefas Concluídas], [NE | Atividades (Qtd)])
		formatString: 0.0%
		displayFolder: 03 - Operação
		lineageTag: d4a05d2c-b2b1-4a40-adc6-4bafe5eaddf3

	/// % Atividades com problema Nordestão.
	measure 'NE | % Atividades Problema' = DIVIDE([NE | Atividades Problema], [NE | Atividades (Qtd)])
		formatString: 0.0%
		displayFolder: 03 - Operação
		lineageTag: b9fb9eca-99a0-4027-9569-6a2a59665f78

	/// Promotores com acesso no projeto Nordestão.
	measure 'NE | Promotores com Acesso' =
			CALCULATE(
			    DISTINCTCOUNT('dim_visitante'[sk_visitante]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0
		displayFolder: 03 - Operação
		lineageTag: e61ccd4b-4187-4e33-8381-4ea0fccede23

	/// Lojas com atividades MobConnect Nordestão.
	measure 'NE | Lojas com Atividades' =
			CALCULATE(
			    DISTINCTCOUNT('fato_mobconnect_atividades'[sk_loja]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0
		displayFolder: 03 - Operação
		lineageTag: c75022ab-43b5-4897-8660-4281d536aa1d

	/// % Cobertura de lojas visitadas Nordestão.
	measure 'NE | % Cobertura Lojas' =
			DIVIDE(
			    [NE | Lojas com Atividades],
			    CALCULATE(DISTINCTCOUNT('dim_loja'[sk_loja]), 'dim_rede'[nm_rede] = "NORDESTAO")
			)
		formatString: 0.0%
		displayFolder: 03 - Operação
		lineageTag: 139ec295-aeb2-47a6-a8d5-cda0d7311dbb

	/// Horas médias por visita Nordestão. (Redireciona para medida unificada)
	measure 'NE | Horas Médias por Visita' = [NE | Prod - Horas por Visita]
		formatString: 0.00
		displayFolder: 03 - Operação
		lineageTag: d6ba2616-42ac-4fce-8eef-741eb8d23fd1

	/// Atividades médias por visita Nordestão.
	measure 'NE | Atividades Médias por Visita' = DIVIDE([NE | Atividades (Qtd)], [NE | Visitas Realizadas])
		formatString: 0.0
		displayFolder: 03 - Operação
		lineageTag: 0f7f946f-b8a5-49e8-b90a-37e157433407

	/// Ranking de promotores por horas realizadas no Nordestão.
	measure 'NE | Ranking Promotor Horas' =
			RANKX(
			    ALLSELECTED('dim_visitante'[nm_visitante]),
			    CALCULATE([NE | Horas Realizadas], 'dim_rede'[nm_rede] = "NORDESTAO")
			)
		formatString: 0
		displayFolder: 03 - Operação
		lineageTag: 087b70fa-382b-4efb-a853-13fc143751c6

	/// Estoque última posição Nordestão.
	measure 'NE | Estoque Última Posição' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[qt_estoque_ultima_posicao]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0
		displayFolder: 04 - Estoque
		lineageTag: e76e5dc5-4492-414b-a748-91361198ef71

	/// Produtos com estoque zero Nordestão.
	measure 'NE | Produtos Estoque Zero' =
			CALCULATE(
			    DISTINCTCOUNT('fato_mobconnect_movimento'[sk_produto_rede]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    'fato_mobconnect_movimento'[qt_estoque] = 0
			)
		formatString: 0
		displayFolder: 04 - Estoque
		lineageTag: 8b61e676-0066-45ad-99f0-44451ee808e2

	/// Produtos com estoque negativo Nordestão.
	measure 'NE | Produtos Estoque Negativo' =
			CALCULATE(
			    DISTINCTCOUNT('fato_mobconnect_movimento'[sk_produto_rede]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    'fato_mobconnect_movimento'[qt_estoque] < 0
			)
		formatString: 0
		displayFolder: 04 - Estoque
		lineageTag: 44112d94-8d4f-4779-ac3f-f744b1d5bff7

	/// Dias de estoque (DDE) Nordestão.
	measure 'NE | Dias de Estoque (DDE)' =
			DIVIDE(
			    [NE | Estoque Última Posição],
			    CALCULATE(
			        DIVIDE(SUM('fato_mobconnect_movimento'[qt_vendida]), 30),
			        'dim_rede'[nm_rede] = "NORDESTAO",
			        DATEADD('Date'[dt_referencia], -1, MONTH)
			    )
			)
		formatString: 0.0
		displayFolder: 04 - Estoque
		lineageTag: cba0d7eb-d228-4e2e-b00d-9fa1a5ba8964

	/// Total de produtos no projeto Nordestão.
	measure 'NE | Produtos (Qtd.)' =
			CALCULATE(
			    DISTINCTCOUNT('fato_mobconnect_movimento'[sk_produto_rede]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0
		displayFolder: 04 - Estoque
		lineageTag: 206ae032-02c8-4408-98ad-a0048076395c

	/// Produtos sem venda M-1 Nordestão.
	measure 'NE | Produtos Sem Venda M-1' =
			CALCULATE(
			    DISTINCTCOUNT('fato_mobconnect_movimento'[sk_produto_rede]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    DATEADD('Date'[dt_referencia], -1, MONTH),
			    'fato_mobconnect_movimento'[qt_vendida] = 0
			)
		formatString: 0
		displayFolder: 04 - Estoque
		lineageTag: 43b064b5-0492-440c-8e6e-f4d6be1643db

	/// Produtos com estoque mas sem venda M-1 Nordestão.
	measure 'NE | Produtos com Estoque Sem Venda' =
			CALCULATE(
			    DISTINCTCOUNT('fato_mobconnect_movimento'[sk_produto_rede]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    DATEADD('Date'[dt_referencia], -1, MONTH),
			    'fato_mobconnect_movimento'[qt_estoque] > 0,
			    'fato_mobconnect_movimento'[qt_vendida] = 0
			)
		formatString: 0
		displayFolder: 04 - Estoque
		lineageTag: 93f473f0-6727-4234-9846-4358adc97efd

	/// Produtos fora de validade Nordestão.
	measure 'NE | Fora de Validade' =
			CALCULATE(
			    COUNTROWS('fato_mobconnect_atividades'),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    'dim_mobconnect_tipo_problema'[ds_tipo_problema] = "Fora de Validade"
			)
		formatString: 0
		displayFolder: 04 - Estoque
		lineageTag: 0f67161f-566d-4e23-9284-f668e073efce

	/// Produtos avariados Nordestão.
	measure 'NE | Produto Avariado' =
			CALCULATE(
			    COUNTROWS('fato_mobconnect_atividades'),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    'dim_mobconnect_tipo_problema'[ds_tipo_problema] = "Produto Avariado"
			)
		formatString: 0
		displayFolder: 04 - Estoque
		lineageTag: 6d1d2317-545a-441a-8447-cada745d24aa

	/// Produtos que não repõem Nordestão.
	measure 'NE | Produtos Não Repõe' =
			CALCULATE(
			    COUNTROWS('fato_mobconnect_atividades'),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    'dim_mobconnect_tipo_problema'[ds_tipo_problema] = "Nao Repoe"
			)
		formatString: 0
		displayFolder: 04 - Estoque
		lineageTag: 3f789b6b-ff22-4e63-81f2-e2653aeb6670

	/// Produtos que não vendem na loja Nordestão.
	measure 'NE | Produtos Não Vende na Loja' =
			CALCULATE(
			    COUNTROWS('fato_mobconnect_atividades'),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    'dim_mobconnect_tipo_problema'[ds_tipo_problema] = "Nao Vende na Loja"
			)
		formatString: 0
		displayFolder: 04 - Estoque
		lineageTag: 136a7984-4f63-4a2a-a836-4bab1274ca2b

	/// % Produtos com problema de estoque Nordestão.
	measure 'NE | % Produtos Problema Estoque' =
			DIVIDE(
			    [NE | Produtos Estoque Zero] + [NE | Produtos Estoque Negativo],
			    [NE | Produtos (Qtd.)]
			)
		formatString: 0.0%
		displayFolder: 04 - Estoque
		lineageTag: 2aa2c495-434a-4546-ab4b-1d0be502e104

	/// Ranking de produtos Nordestão por ruptura operacional.
	measure 'NE | Ranking Produto Ruptura Op' =
			RANKX(
			    ALLSELECTED('dim_produto_rede'[ds_produto_rede]),
			    CALCULATE([NE | Ruptura Operacional (R$)], 'dim_rede'[nm_rede] = "NORDESTAO")
			)
		formatString: 0
		displayFolder: 04 - Estoque
		lineageTag: 6c9946b7-69bf-4c16-a2a7-426c9aa6edc2

	/// % acumulado de ruptura por produto para Pareto Nordestão.
	measure 'NE | % Acumulado Ruptura Produto' =
			VAR _totalRuptura = CALCULATE([NE | Ruptura Operacional (R$)], ALL('dim_produto_rede'))
			RETURN DIVIDE(
			    CALCULATE([NE | Ruptura Operacional (R$)], 'dim_rede'[nm_rede] = "NORDESTAO"),
			    _totalRuptura
			)
		formatString: 0.0%
		displayFolder: 04 - Estoque
		lineageTag: 13e2eec4-ff65-40e7-9348-b7413f80d053

	/// Score de saúde operacional do Nordestão (0-100) combinando horas, visitas, tarefas e ruptura.
	measure 'NE | Score Saúde Operacional' =
			VAR _scoreHoras = MIN(1, [NE | % Eficiência Horas]) * 25
			VAR _scoreVisitas = MIN(1, [NE | % Execução Visitas]) * 25
			VAR _scoreTarefas = MIN(1, [NE | % Tarefas Concluídas]) * 25
			VAR _scoreRuptura = (1 - MIN(1, [NE | % Ruptura Operacional] / 0.20)) * 25
			RETURN _scoreHoras + _scoreVisitas + _scoreTarefas + _scoreRuptura
		formatString: 0.0
		displayFolder: 05 - Executivo
		lineageTag: 7c906f3f-945c-4f15-8ae4-9964cce7e82a

	/// Classifica o score de saúde operacional do Nordestão.
	measure 'NE | Faixa Saúde Operacional' =
			VAR _score = [NE | Score Saúde Operacional]
			RETURN SWITCH(TRUE(), _score >= 80, "Saudavel", _score >= 60, "Atencao", _score >= 40, "Critico", "Grave")
		displayFolder: 05 - Executivo
		lineageTag: b8fa064f-4b57-4182-930e-d6451877a032

	/// Lojas cadastradas na rede Nordestão.
	measure 'NE | Lojas Cadastradas' =
			CALCULATE(
			    DISTINCTCOUNT('dim_loja'[sk_loja]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0
		displayFolder: 05 - Executivo
		lineageTag: 0d44977d-2398-4e5e-86e3-e101fd11cedd

	/// Lojas no projeto Nordestão.
	measure 'NE | Lojas no Projeto' =
			CALCULATE(
			    DISTINCTCOUNT('fato_mobconnect_movimento'[sk_loja]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0
		displayFolder: 05 - Executivo
		lineageTag: 1899fccb-937c-4599-953c-a4fb5be31006

	/// Fornecedores cadastrados no projeto Nordestão.
	measure 'NE | Fornecedores no Projeto' =
			CALCULATE(
			    DISTINCTCOUNT('fato_mobconnect_movimento'[sk_fornecedor]),
			    'dim_rede'[nm_rede] = "NORDESTAO"
			)
		formatString: 0
		displayFolder: 05 - Executivo
		lineageTag: 3f738839-ae63-4456-971f-dbe580fb6be4

	/// Compara ruptura operacional do Nordestão vs média geral de todas as redes.
	measure 'NE | GAP Ruptura vs Média Geral' =
			VAR _ne = [NE | % Ruptura Operacional]
			VAR _geral = CALCULATE(
			    DIVIDE(SUM('fato_mobconnect_movimento'[vl_ruptura_operacional]), SUM('fato_mobconnect_movimento'[vl_venda_total])),
			    ALL('dim_rede')
			)
			RETURN _ne - _geral
		formatString: 0.0%
		displayFolder: 05 - Executivo
		lineageTag: bbf1c371-9516-458d-98d6-967575b74cbf

	/// Status do Nordestão vs média geral de ruptura.
	measure 'NE | Status vs Média Geral' =
			VAR _gap = [NE | GAP Ruptura vs Média Geral]
			RETURN SWITCH(TRUE(), _gap < 0, "Abaixo da Media", _gap = 0, "Na Media", "Acima da Media")
		displayFolder: 05 - Executivo
		lineageTag: ae871249-e6bd-4f5b-8598-5eb8f91d374c

	/// Representação do Nordestão no total de vendas de todas as redes.
	measure 'NE | % Representação nas Vendas Totais' =
			DIVIDE(
			    [NE | Venda (R$)],
			    CALCULATE(SUM('fato_mobconnect_movimento'[vl_venda_total]), ALL('dim_rede'))
			)
		formatString: 0.0%
		displayFolder: 05 - Executivo
		lineageTag: 6e97ab30-0355-4ecc-9fce-1b1b9025f148

	/// Card executivo de vendas Nordestão.
	measure 'NE | Card Vendas' =
			VAR _venda = [Venda M-1]
			VAR _var = [NE | Variação Vendas MoM]
			RETURN "Venda M-1: " & FORMAT(_venda, "R$ #,0") & " | Var: " & FORMAT(_var, "0.0%")
		displayFolder: 05 - Executivo
		lineageTag: 797f5594-1102-488e-b5db-ed547a83317e

	/// Card executivo de ruptura Nordestão.
	measure 'NE | Card Ruptura' =
			VAR _rup = [NE | Ruptura Operacional (R$)]
			VAR _pct = [NE | % Ruptura Operacional]
			RETURN "Ruptura Op: " & FORMAT(_rup, "R$ #,0") & " | %: " & FORMAT(_pct, "0.0%")
		displayFolder: 05 - Executivo
		lineageTag: 559fdb73-2116-4c03-8f96-50dbb040ff7d

	/// Card executivo operacional Nordestão.
	measure 'NE | Card Operação' =
			VAR _hrs = [NE | % Eficiência Horas]
			VAR _vis = [NE | % Execução Visitas]
			RETURN "Efic. Horas: " & FORMAT(_hrs, "0.0%") & " | Exec. Visitas: " & FORMAT(_vis, "0.0%")
		displayFolder: 05 - Executivo
		lineageTag: 747cde1a-fe49-44e3-a523-fba3f0c44bb7

	/// Painel de alertas executivo consolidado Nordestão.
	measure 'NE | Painel Alertas Executivo' =
			VAR _semRuptura = IF([NE | Semáforo Ruptura Op] = "Vermelho", "ALERTA: Ruptura alta | ", "")
			VAR _semHoras = IF([NE | Semáforo Eficiência Horas] = "Vermelho", "ALERTA: Horas baixas | ", "")
			VAR _saude = "Saude: " & [NE | Faixa Saúde Operacional]
			RETURN _semRuptura & _semHoras & _saude
		displayFolder: 05 - Executivo
		lineageTag: 0a2942f6-e6fb-4d48-8f65-48cfd931e899

	/// Impacto financeiro total de ruptura Nordestão.
	measure 'NE | Impacto Total Ruptura (R$)' = [NE | Ruptura Total (R$)]
		formatString: "R$" #,0.00
		displayFolder: 05 - Executivo
		lineageTag: 82f2b995-a224-4001-87be-230f285b8023

	/// Venda YoY Nordestão.
	measure 'NE | Venda YoY (R$)' =
			CALCULATE(
			    SUM('fato_mobconnect_movimento'[vl_venda_total]),
			    'dim_rede'[nm_rede] = "NORDESTAO",
			    SAMEPERIODLASTYEAR('Date'[dt_referencia])
			)
		formatString: "R$" #,0.00
		displayFolder: 05 - Executivo
		lineageTag: 3842a6eb-21e6-41d6-b95a-740e629edc9c

	/// Variação YoY de vendas Nordestão.
	measure 'NE | Variação Vendas YoY' =
			DIVIDE(
			    [NE | Venda (R$)] - [NE | Venda YoY (R$)],
			    [NE | Venda YoY (R$)]
			)
		formatString: 0.0%
		displayFolder: 05 - Executivo
		lineageTag: debc2e11-4892-4136-b73d-65827b5957d1

	/// Horas realizadas por visita - mede densidade de trabalho por visita
	measure 'NE | Prod - Horas por Visita' =
			DIVIDE(
			    [NE | Horas Realizadas],
			    [NE | Visitas Realizadas]
			)
		formatString: 0.00
		displayFolder: 06 - Correlação Produtividade\01 - Indicadores Base
		lineageTag: 35e2f843-f182-4025-942a-47d91db62191

	/// Atividades realizadas por visita - mede intensidade operacional por visita
	measure 'NE | Prod - Atividades por Visita' =
			DIVIDE(
			    [NE | Atividades (Qtd)],
			    [NE | Visitas Realizadas]
			)
		formatString: 0.00
		displayFolder: 06 - Correlação Produtividade\01 - Indicadores Base
		lineageTag: d01d150d-9597-4f74-9258-cf5e7457b135

	/// Tarefas concluídas por hora trabalhada - eficiência operacional
	measure 'NE | Prod - Tarefas por Hora' =
			DIVIDE(
			    [NE | Tarefas Concluídas],
			    [NE | Horas Realizadas]
			)
		formatString: 0.00
		displayFolder: 06 - Correlação Produtividade\01 - Indicadores Base
		lineageTag: 1a651148-cf2d-4eb2-832e-2a08f7ccec17

	/// % de lojas visitadas com atividades registradas - cobertura efetiva
	measure 'NE | Prod - Cobertura Efetiva' =
			DIVIDE(
			    [NE | Lojas com Atividades],
			    [NE | Lojas no Projeto]
			)
		formatString: 0.0%
		displayFolder: 06 - Correlação Produtividade\01 - Indicadores Base
		lineageTag: 7a998588-eb19-4960-9076-c98b74b7d60a

	/// Score composto de produtividade do promotor (0-100)
	measure 'NE | Prod - Score Produtividade' =
			VAR _eficHoras   = MIN(1, [NE | % Eficiência Horas])   * 30
			VAR _execVisitas = MIN(1, [NE | % Execução Visitas]) * 30
			VAR _cobertura   = MIN(1, [NE | Prod - Cobertura Efetiva]) * 20
			VAR _tarefas     = MIN(1, [NE | % Tarefas Concluídas])  * 20
			RETURN _eficHoras + _execVisitas + _cobertura + _tarefas
		formatString: 0.0
		displayFolder: 06 - Correlação Produtividade\01 - Indicadores Base
		lineageTag: 26932598-0c40-47d8-95a5-b2549135ab20

	/// Classifica o score de produtividade em faixas
	measure 'NE | Prod - Faixa Produtividade' =
			VAR _s = [NE | Prod - Score Produtividade]
			RETURN SWITCH(TRUE(),
			    _s >= 80, "Alta",
			    _s >= 60, "Media",
			    _s >= 40, "Baixa",
			    "Critica"
			)
		displayFolder: 06 - Correlação Produtividade\01 - Indicadores Base
		lineageTag: 26a35b91-4dda-4798-8e7b-9f7e4df8b916

	/// Ruptura operacional por loja visitada - quanto de ruptura existe por loja atendida
	measure 'NE | Corr - Ruptura por Loja Visitada' =
			DIVIDE(
			    [NE | Ruptura Operacional (R$)],
			    [NE | Lojas com Atividades]
			)
		formatString: "R$" #,0.00
		displayFolder: 06 - Correlação Produtividade\02 - Correlação Ruptura
		lineageTag: 13ba478c-80c6-4db1-93f3-29da4bedfe04

	/// Variação da ruptura quando a eficiência de horas é alta (>=80%) vs baixa
	measure 'NE | Corr - Impacto Efic Horas na Ruptura' =
			VAR _rupturaAltaEfic =
			    CALCULATE(
			        DIVIDE(SUM('fato_mobconnect_movimento'[vl_ruptura_operacional]), SUM('fato_mobconnect_movimento'[vl_venda_total])),
			        'dim_rede'[nm_rede] = "NORDESTAO",
			        FILTER(
			            VALUES('dim_visitante'[sk_visitante]),
			            DIVIDE(
			                CALCULATE(SUM('fato_mobconnect_atendimento_fornecedores'[qt_horas_atendimento])),
			                CALCULATE(SUM('fato_horas_ideais'[qt_horas_ideais]))
			            ) >= 0.8
			        )
			    )
			VAR _rupturaBaixaEfic =
			    CALCULATE(
			        DIVIDE(SUM('fato_mobconnect_movimento'[vl_ruptura_operacional]), SUM('fato_mobconnect_movimento'[vl_venda_total])),
			        'dim_rede'[nm_rede] = "NORDESTAO",
			        FILTER(
			            VALUES('dim_visitante'[sk_visitante]),
			            DIVIDE(
			                CALCULATE(SUM('fato_mobconnect_atendimento_fornecedores'[qt_horas_atendimento])),
			                CALCULATE(SUM('fato_horas_ideais'[qt_horas_ideais]))
			            ) < 0.8
			        )
			    )
			RETURN _rupturaBaixaEfic - _rupturaAltaEfic
		formatString: 0.0%
		displayFolder: 06 - Correlação Produtividade\02 - Correlação Ruptura
		lineageTag: e318958a-9403-4317-a34a-b3a8aaa2b5e0

	/// Ruptura média nas lojas COM visita vs SEM visita no mês
	measure 'NE | Corr - Ruptura Lojas Com vs Sem Visita' =
			VAR _lojasComVisita =
			    CALCULATETABLE(
			        VALUES('fato_mobconnect_visitas'[sk_loja]),
			        'dim_rede'[nm_rede] = "NORDESTAO",
			        'fato_mobconnect_visitas'[qt_visitas_realizadas] > 0
			    )
			VAR _lojasSemVisita =
			    CALCULATETABLE(
			        EXCEPT(
			            VALUES('dim_loja'[sk_loja]),
			            VALUES('fato_mobconnect_visitas'[sk_loja])
			        ),
			        'dim_rede'[nm_rede] = "NORDESTAO"
			    )
			VAR _rupturaComVisita =
			    CALCULATE(
			        DIVIDE(SUM('fato_mobconnect_movimento'[vl_ruptura_operacional]), SUM('fato_mobconnect_movimento'[vl_venda_total])),
			        KEEPFILTERS('fato_mobconnect_movimento'[sk_loja] IN _lojasComVisita)
			    )
			VAR _rupturaSemVisita =
			    CALCULATE(
			        DIVIDE(SUM('fato_mobconnect_movimento'[vl_ruptura_operacional]), SUM('fato_mobconnect_movimento'[vl_venda_total])),
			        KEEPFILTERS('fato_mobconnect_movimento'[sk_loja] IN _lojasSemVisita)
			    )
			RETURN _rupturaSemVisita - _rupturaComVisita
		formatString: 0.0%
		displayFolder: 06 - Correlação Produtividade\02 - Correlação Ruptura
		lineageTag: b54f8cba-cddf-41ce-af28-a7eced9b0420

	/// Redução estimada de ruptura por ponto percentual de melhora na eficiência de horas
	measure 'NE | Corr - Redução Ruptura por 1% Efic' =
			DIVIDE(
			    [NE | Corr - Impacto Efic Horas na Ruptura],
			    0.2
			)
		formatString: 0.0%
		displayFolder: 06 - Correlação Produtividade\02 - Correlação Ruptura
		lineageTag: 4451fc9d-40d2-461a-8455-e0954707ad1b

	/// Receita recuperável se a eficiência de horas chegar a 100%
	measure 'NE | Corr - Receita Recuperável por Produtividade' =
			VAR _gapEfic = 1 - [NE | % Eficiência Horas]
			VAR _impactoPorPonto = [NE | Corr - Redução Ruptura por 1% Efic]
			VAR _reducaoRupturaEstimada = _gapEfic * _impactoPorPonto
			RETURN [NE | Venda (R$)] * _reducaoRupturaEstimada
		formatString: "R$" #,0.00
		displayFolder: 06 - Correlação Produtividade\02 - Correlação Ruptura
		lineageTag: 4e1fe771-22a4-48e2-9de4-9876d3d4222e

	/// Venda por hora trabalhada pelo promotor - produtividade financeira
	measure 'NE | Corr - Venda por Hora Trabalhada' =
			DIVIDE(
			    [NE | Venda (R$)],
			    [NE | Horas Realizadas]
			)
		formatString: "R$" #,0.00
		displayFolder: 06 - Correlação Produtividade\03 - Correlação Vendas
		lineageTag: 10290ba5-9ce0-49e3-bf26-a8fb7787e83c

	/// Venda por visita realizada - retorno financeiro por visita
	measure 'NE | Corr - Venda por Visita' =
			DIVIDE(
			    [NE | Venda (R$)],
			    [NE | Visitas Realizadas]
			)
		formatString: "R$" #,0.00
		displayFolder: 06 - Correlação Produtividade\03 - Correlação Vendas
		lineageTag: c83b6395-3001-4e8c-8e36-b53583a43d25

	/// Diferença de venda média entre lojas COM visita vs SEM visita
	measure 'NE | Corr - Uplift Venda Com Visita' =
			VAR _lojasComVisita =
			    CALCULATETABLE(
			        VALUES('fato_mobconnect_visitas'[sk_loja]),
			        'dim_rede'[nm_rede] = "NORDESTAO",
			        'fato_mobconnect_visitas'[qt_visitas_realizadas] > 0
			    )
			VAR _lojasSemVisita =
			    CALCULATETABLE(
			        EXCEPT(
			            VALUES('dim_loja'[sk_loja]),
			            VALUES('fato_mobconnect_visitas'[sk_loja])
			        ),
			        'dim_rede'[nm_rede] = "NORDESTAO"
			    )
			VAR _vendaComVisita =
			    CALCULATE(
			        DIVIDE(SUM('fato_mobconnect_movimento'[vl_venda_total]), DISTINCTCOUNT('fato_mobconnect_movimento'[sk_loja])),
			        KEEPFILTERS('fato_mobconnect_movimento'[sk_loja] IN _lojasComVisita)
			    )
			VAR _vendaSemVisita =
			    CALCULATE(
			        DIVIDE(SUM('fato_mobconnect_movimento'[vl_venda_total]), DISTINCTCOUNT('fato_mobconnect_movimento'[sk_loja])),
			        KEEPFILTERS('fato_mobconnect_movimento'[sk_loja] IN _lojasSemVisita)
			    )
			RETURN _vendaComVisita - _vendaSemVisita
		formatString: "R$" #,0.00
		displayFolder: 06 - Correlação Produtividade\03 - Correlação Vendas
		lineageTag: f640832b-f218-4396-9979-3ddffee7ec4b

	/// Venda incremental estimada se todas as lojas fossem visitadas
	measure 'NE | Corr - Venda Incremental Pot Cobertura' =
			VAR _lojasSemVisita =
			    CALCULATE(
			        DISTINCTCOUNT('dim_loja'[sk_loja]),
			        'dim_rede'[nm_rede] = "NORDESTAO"
			    ) -
			    CALCULATE(
			        DISTINCTCOUNT('fato_mobconnect_visitas'[sk_loja]),
			        'dim_rede'[nm_rede] = "NORDESTAO",
			        'fato_mobconnect_visitas'[qt_visitas_realizadas] > 0
			    )
			RETURN _lojasSemVisita * [NE | Corr - Uplift Venda Com Visita]
		formatString: "R$" #,0.00
		displayFolder: 06 - Correlação Produtividade\03 - Correlação Vendas
		lineageTag: 2e582a87-0f67-480d-90ed-b7438cb1d2c0

	/// Variação de venda quando eficiência de horas é alta vs baixa
	measure 'NE | Corr - Impacto Efic Horas na Venda' =
			VAR _vendaAltaEfic =
			    CALCULATE(
			        DIVIDE(SUM('fato_mobconnect_movimento'[vl_venda_total]), DISTINCTCOUNT('fato_mobconnect_movimento'[sk_loja])),
			        'dim_rede'[nm_rede] = "NORDESTAO",
			        FILTER(
			            VALUES('dim_visitante'[sk_visitante]),
			            DIVIDE(
			                CALCULATE(SUM('fato_mobconnect_atendimento_fornecedores'[qt_horas_atendimento])),
			                CALCULATE(SUM('fato_horas_ideais'[qt_horas_ideais]))
			            ) >= 0.8
			        )
			    )
			VAR _vendaBaixaEfic =
			    CALCULATE(
			        DIVIDE(SUM('fato_mobconnect_movimento'[vl_venda_total]), DISTINCTCOUNT('fato_mobconnect_movimento'[sk_loja])),
			        'dim_rede'[nm_rede] = "NORDESTAO",
			        FILTER(
			            VALUES('dim_visitante'[sk_visitante]),
			            DIVIDE(
			                CALCULATE(SUM('fato_mobconnect_atendimento_fornecedores'[qt_horas_atendimento])),
			                CALCULATE(SUM('fato_horas_ideais'[qt_horas_ideais]))
			            ) < 0.8
			        )
			    )
			RETURN _vendaAltaEfic - _vendaBaixaEfic
		formatString: "R$" #,0.00
		displayFolder: 06 - Correlação Produtividade\03 - Correlação Vendas
		lineageTag: 7673c31c-c26a-46ab-8560-d5006f51a8bc

	/// Ranking do promotor por score de produtividade
	measure 'NE | Rank - Promotor por Produtividade' =
			RANKX(
			    ALLSELECTED('dim_visitante'[nm_visitante]),
			    [NE | Prod - Score Produtividade],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		displayFolder: 06 - Correlação Produtividade\04 - Ranking Promotores
		lineageTag: b04244c5-91ce-49a7-b3fa-fb2558c10619

	/// Ranking do promotor por impacto na redução de ruptura (menor ruptura nas lojas que atende)
	measure 'NE | Rank - Promotor por Menor Ruptura' =
			RANKX(
			    ALLSELECTED('dim_visitante'[nm_visitante]),
			    [NE | % Ruptura Operacional],
			    ,
			    ASC,
			    DENSE
			)
		formatString: 0
		displayFolder: 06 - Correlação Produtividade\04 - Ranking Promotores
		lineageTag: ce770fd8-e9b9-478d-ac1d-3942edcebdbe

	/// Ranking do promotor por venda gerada nas lojas que atende
	measure 'NE | Rank - Promotor por Venda' =
			RANKX(
			    ALLSELECTED('dim_visitante'[nm_visitante]),
			    [NE | Venda (R$)],
			    ,
			    DESC,
			    DENSE
			)
		formatString: 0
		displayFolder: 06 - Correlação Produtividade\04 - Ranking Promotores
		lineageTag: f015cd63-bc83-4b08-b265-898782657ff6

	/// Classifica o promotor em quadrante: Alta Prod + Baixa Ruptura = Estrela, etc.
	measure 'NE | Rank - Quadrante Promotor' =
			VAR _prod = [NE | Prod - Score Produtividade]
			VAR _rupt = [NE | % Ruptura Operacional]
			VAR _mediaRupt = CALCULATE([NE | % Ruptura Operacional], ALL('dim_visitante'))
			VAR _mediaProd = CALCULATE([NE | Prod - Score Produtividade], ALL('dim_visitante'))
			RETURN SWITCH(TRUE(),
			    _prod >= _mediaProd && _rupt <= _mediaRupt, "Estrela",
			    _prod >= _mediaProd && _rupt >  _mediaRupt, "Potencial",
			    _prod <  _mediaProd && _rupt <= _mediaRupt, "Eficiente",
			    "Critico"
			)
		displayFolder: 06 - Correlação Produtividade\04 - Ranking Promotores
		lineageTag: bed92f06-1689-420b-a644-faac9e6a7570

	/// Venda incremental estimada se todos os promotores atingissem score >= 80
	measure 'NE | Rank - Potencial Venda se 100% Visitas' =
			VAR _vendaAtual = [NE | Venda (R$)]
			VAR _upliftPorVisita = [NE | Corr - Venda por Visita]
			VAR _gapVisitas = [NE | Visitas Planejadas] - [NE | Visitas Realizadas]
			RETURN IF(_gapVisitas > 0, _gapVisitas * _upliftPorVisita, 0)
		formatString: "R$" #,0.00
		displayFolder: 06 - Correlação Produtividade\04 - Ranking Promotores
		lineageTag: 003636a2-5d4a-41f6-95e7-0ddd56569087

	/// Simula o impacto financeiro total se a produtividade atingir meta de 80%
	measure 'NE | Sim - Impacto Financeiro Meta 80%' =
			VAR _gapEficHoras   = MAX(0, 0.8 - [NE | % Eficiência Horas])
			VAR _gapExecVisitas = MAX(0, 0.8 - [NE | % Execução Visitas])
			VAR _ganhoVendaHoras   = _gapEficHoras   * [NE | Corr - Impacto Efic Horas na Venda]
			VAR _ganhoVendaVisitas = _gapExecVisitas * [NE | Corr - Venda por Visita] * [NE | Visitas Planejadas]
			VAR _reducaoRuptura    = _gapEficHoras   * [NE | Corr - Redução Ruptura por 1% Efic] * [NE | Venda (R$)]
			RETURN _ganhoVendaHoras + _ganhoVendaVisitas + _reducaoRuptura
		formatString: "R$" #,0.00
		displayFolder: 06 - Correlação Produtividade\05 - Simulação de Impacto
		lineageTag: 46a51ff8-d43e-4eaf-b057-86d3d7884cc8

	/// Simula o impacto financeiro total se a produtividade atingir meta de 100%
	measure 'NE | Sim - Impacto Financeiro Meta 100%' =
			VAR _gapEficHoras   = MAX(0, 1 - [NE | % Eficiência Horas])
			VAR _gapExecVisitas = MAX(0, 1 - [NE | % Execução Visitas])
			VAR _ganhoVendaHoras   = _gapEficHoras   * [NE | Corr - Impacto Efic Horas na Venda]
			VAR _ganhoVendaVisitas = _gapExecVisitas * [NE | Corr - Venda por Visita] * [NE | Visitas Planejadas]
			VAR _reducaoRuptura    = _gapEficHoras   * [NE | Corr - Redução Ruptura por 1% Efic] * [NE | Venda (R$)]
			RETURN _ganhoVendaHoras + _ganhoVendaVisitas + _reducaoRuptura
		formatString: "R$" #,0.00
		displayFolder: 06 - Correlação Produtividade\05 - Simulação de Impacto
		lineageTag: bc217ebb-562b-4530-a595-da4f64f87cfa

	/// ROI estimado de cada hora adicional de promotor em campo
	measure 'NE | Sim - ROI por Hora de Promotor' =
			DIVIDE(
			    [NE | Corr - Venda por Hora Trabalhada] + DIVIDE([NE | Corr - Receita Recuperável por Produtividade], [NE | Horas Realizadas]),
			    1
			)
		formatString: "R$" #,0.00
		displayFolder: 06 - Correlação Produtividade\05 - Simulação de Impacto
		lineageTag: 630e98ee-283b-4a38-b639-7b1d9a4155fd

	/// Texto resumo do impacto da produtividade para card executivo
	measure 'NE | Sim - Card Impacto Produtividade' =
			VAR _score    = [NE | Prod - Score Produtividade]
			VAR _faixa    = [NE | Prod - Faixa Produtividade]
			VAR _impacto  = [NE | Sim - Impacto Financeiro Meta 80%]
			VAR _ruptura  = [NE | Corr - Impacto Efic Horas na Ruptura]
			RETURN
			    "Score: " & FORMAT(_score, "0.0") & " (" & _faixa & ")" &
			    " | Pot. Ganho: " & FORMAT(_impacto, "R$ #,0") &
			    " | Redução Ruptura: " & FORMAT(_ruptura, "0.0%")
		displayFolder: 06 - Correlação Produtividade\05 - Simulação de Impacto
		lineageTag: 23affec7-d104-4646-b417-2fb4c52bfd51

	/// Retorna 1 se a data selecionada é feriado em Natal/RN
	measure 'NE | Fer - É Feriado' =
			IF(
			    COUNTROWS(
			        FILTER('Feriados Natal RN', 'Feriados Natal RN'[dt_feriado] = MAX('Date'[dt_referencia]))
			    ) > 0, 1, 0
			)
		formatString: 0
		displayFolder: 07 - Feriados Natal RN\01 - Contexto
		lineageTag: b32c6369-cf57-44ad-ba62-250f8bc21712

	/// Nome do feriado na data selecionada, ou vazio se não for feriado
	measure 'NE | Fer - Nome Feriado' =
			VAR _data = MAX('Date'[dt_referencia])
			RETURN
			    CALCULATE(
			        FIRSTNONBLANK('Feriados Natal RN'[nm_feriado], 1),
			        'Feriados Natal RN'[dt_feriado] = _data
			    )
		displayFolder: 07 - Feriados Natal RN\01 - Contexto
		lineageTag: a31017a7-bb38-4254-862b-0129ab36959f

	/// Tipo do feriado: Nacional, Estadual, Municipal ou Facultativo
	measure 'NE | Fer - Tipo Feriado' =
			VAR _data = MAX('Date'[dt_referencia])
			RETURN
			    CALCULATE(
			        FIRSTNONBLANK('Feriados Natal RN'[tp_feriado], 1),
			        'Feriados Natal RN'[dt_feriado] = _data
			    )
		displayFolder: 07 - Feriados Natal RN\01 - Contexto
		lineageTag: e974341c-7bd3-4c49-aa95-d344cfb28cb7

	/// Quantidade de feriados no período selecionado
	measure 'NE | Fer - Qtd Feriados no Período' =
			CALCULATE(
			    COUNTROWS('Feriados Natal RN'),
			    DATESBETWEEN(
			        'Date'[dt_referencia],
			        MIN('Date'[dt_referencia]),
			        MAX('Date'[dt_referencia])
			    )
			)
		formatString: 0
		displayFolder: 07 - Feriados Natal RN\01 - Contexto
		lineageTag: 2d90d6da-cff3-44ff-9895-d495df4190a6

	/// Quantidade de feriados no mês atual do contexto
	measure 'NE | Fer - Feriados no Mês' =
			CALCULATE(
			    COUNTROWS('Feriados Natal RN'),
			    DATESMTD('Date'[dt_referencia])
			)
		formatString: 0
		displayFolder: 07 - Feriados Natal RN\01 - Contexto
		lineageTag: ac7b7de0-a177-48f1-b21f-ec5912357d16

	/// Dias úteis esperados no mês descontando feriados e fins de semana
	measure 'NE | Fer - Dias Úteis no Mês' =
			VAR _diasMes = COUNTROWS(DATESMTD('Date'[dt_referencia]))
			VAR _feriados = [NE | Fer - Feriados no Mês]
			VAR _fimSemana = CALCULATE(
			    COUNTROWS('Date'),
			    DATESMTD('Date'[dt_referencia]),
			    'Date'[nu_dia_semana] IN {1, 7}
			)
			RETURN _diasMes - _feriados - _fimSemana
		formatString: 0
		displayFolder: 07 - Feriados Natal RN\01 - Contexto
		lineageTag: a394333e-b19b-41a5-8551-f4fe5ad50e98

	/// Visitas realizadas ajustadas pelos dias úteis reais (desconta feriados)
	measure 'NE | Fer - Visitas Ajustadas por Feriado' =
			VAR _diasUteis = [NE | Fer - Dias Úteis no Mês]
			VAR _diasMes = COUNTROWS(DATESMTD('Date'[dt_referencia]))
			VAR _fatorAjuste = DIVIDE(_diasMes, IF(_diasUteis = 0, 1, _diasUteis))
			RETURN [NE | Visitas Realizadas] * _fatorAjuste
		formatString: 0
		displayFolder: 07 - Feriados Natal RN\02 - Produtividade Ajustada
		lineageTag: 0159f19d-d609-4081-8350-fb135158a988

	/// % execução de visitas recalculada considerando feriados como dias não trabalhados
	measure 'NE | Fer - % Execução Visitas Ajustada' =
			VAR _diasUteis = [NE | Fer - Dias Úteis no Mês]
			VAR _diasMes = COUNTROWS(DATESMTD('Date'[dt_referencia]))
			VAR _metaAjustada = [NE | Visitas Planejadas] * DIVIDE(_diasUteis, IF(_diasMes = 0, 1, _diasMes))
			RETURN DIVIDE([NE | Visitas Realizadas], _metaAjustada)
		formatString: 0.0%
		displayFolder: 07 - Feriados Natal RN\02 - Produtividade Ajustada
		lineageTag: 13f38588-7318-4fbc-bca1-58782e727011

	/// Horas realizadas ajustadas pelos dias úteis reais (desconta feriados)
	measure 'NE | Fer - Horas Ajustadas por Feriado' =
			VAR _diasUteis = [NE | Fer - Dias Úteis no Mês]
			VAR _diasMes = COUNTROWS(DATESMTD('Date'[dt_referencia]))
			VAR _fatorAjuste = DIVIDE(_diasMes, IF(_diasUteis = 0, 1, _diasUteis))
			RETURN [NE | Horas Realizadas] * _fatorAjuste
		formatString: 0.0
		displayFolder: 07 - Feriados Natal RN\02 - Produtividade Ajustada
		lineageTag: ab40ce64-c964-4c67-9336-ff6981dfb871

	/// Eficiência de horas recalculada considerando feriados como dias não trabalhados
	measure 'NE | Fer - % Eficiência Horas Ajustada' =
			VAR _diasUteis = [NE | Fer - Dias Úteis no Mês]
			VAR _diasMes = COUNTROWS(DATESMTD('Date'[dt_referencia]))
			VAR _metaAjustada = [NE | Horas Ideais] * DIVIDE(_diasUteis, IF(_diasMes = 0, 1, _diasMes))
			RETURN DIVIDE([NE | Horas Realizadas], _metaAjustada)
		formatString: 0.0%
		displayFolder: 07 - Feriados Natal RN\02 - Produtividade Ajustada
		lineageTag: 8d53229e-38b8-42fb-9745-1f6aaadbb447

	/// Score de produtividade recalculado descontando o impacto dos feriados
	measure 'NE | Fer - Score Produtividade Ajustado' =
			VAR _eficHoras   = MIN(1, [NE | Fer - % Eficiência Horas Ajustada])   * 30
			VAR _execVisitas = MIN(1, [NE | Fer - % Execução Visitas Ajustada]) * 30
			VAR _cobertura   = MIN(1, [NE | Prod - Cobertura Efetiva])             * 20
			VAR _tarefas     = MIN(1, [NE | % Tarefas Concluídas])                * 20
			RETURN _eficHoras + _execVisitas + _cobertura + _tarefas
		formatString: 0.0
		displayFolder: 07 - Feriados Natal RN\02 - Produtividade Ajustada
		lineageTag: 67da3b7a-be7b-4136-840a-af06e45a3107

	/// Diferença entre o score ajustado e o score original — mostra o impacto dos feriados
	measure 'NE | Fer - Impacto Feriado no Score' = [NE | Fer - Score Produtividade Ajustado] - [NE | Prod - Score Produtividade]
		formatString: 0.0
		displayFolder: 07 - Feriados Natal RN\02 - Produtividade Ajustada
		lineageTag: fbf1d080-725b-4f83-8b96-1cec83fdd7a3

	/// Explica o motivo da baixa produtividade considerando feriados no período
	measure 'NE | Fer - Diagnóstico Produtividade' =
			VAR _feriados    = [NE | Fer - Qtd Feriados no Período]
			VAR _execVisitas = [NE | % Execução Visitas]
			VAR _execAjust   = [NE | Fer - % Execução Visitas Ajustada]
			VAR _eficHoras   = [NE | % Eficiência Horas]
			VAR _eficAjust   = [NE | Fer - % Eficiência Horas Ajustada]
			VAR _nomeFer     = [NE | Fer - Nome Feriado]
			RETURN SWITCH(TRUE(),
			    _feriados > 0 && _execVisitas < 0.7 && _execAjust >= 0.8,
			        "Baixa visita justificada por feriado: " & _nomeFer,
			    _feriados > 0 && _eficHoras < 0.7 && _eficAjust >= 0.8,
			        "Baixa efic. horas justificada por feriado: " & _nomeFer,
			    _feriados > 0 && _execVisitas < 0.7,
			        "Feriado (" & _nomeFer & ") não justifica totalmente a baixa visita",
			    _feriados = 0 && _execVisitas < 0.7,
			        "Baixa visita SEM feriado — requer investigação",
			    _feriados = 0 && _eficHoras < 0.7,
			        "Baixa eficiência SEM feriado — requer investigação",
			    "Produtividade dentro do esperado"
			)
		displayFolder: 07 - Feriados Natal RN\03 - Diagnóstico
		lineageTag: cdff65eb-6892-4d00-946e-eab4e0afd1ef

	/// Classifica se a baixa produtividade é justificada por feriado ou não
	measure 'NE | Fer - Status Justificativa' =
			VAR _feriados  = [NE | Fer - Qtd Feriados no Período]
			VAR _execAjust = [NE | Fer - % Execução Visitas Ajustada]
			VAR _eficAjust = [NE | Fer - % Eficiência Horas Ajustada]
			RETURN SWITCH(TRUE(),
			    _feriados > 0 && _execAjust >= 0.8 && _eficAjust >= 0.8, "Justificado",
			    _feriados > 0 && (_execAjust >= 0.6 || _eficAjust >= 0.6), "Parcialmente Justificado",
			    _feriados = 0, "Não Justificado",
			    "Investigar"
			)
		displayFolder: 07 - Feriados Natal RN\03 - Diagnóstico
		lineageTag: 51477455-9fe5-43e2-9350-1ee188690051

	/// Lista os feriados do mês atual para exibir em tooltip ou card
	measure 'NE | Fer - Card Contexto Feriado' =
			VAR _qtd = [NE | Fer - Feriados no Mês]
			VAR _diasUteis = [NE | Fer - Dias Úteis no Mês]
			VAR _impactoScore = [NE | Fer - Impacto Feriado no Score]
			RETURN
			    "Feriados no mês: " & _qtd &
			    " | Dias úteis: " & _diasUteis &
			    " | Impacto no Score: +" & FORMAT(_impactoScore, "0.0")
		displayFolder: 07 - Feriados Natal RN\03 - Diagnóstico
		lineageTag: cd516858-4284-481d-a8a3-75bf7dc5d810

	/// Visitas esperadas ajustadas pela proporção de dias úteis reais no mês
	measure 'NE | Fer - Meta Visitas Ajustada' =
			VAR _diasUteis = [NE | Fer - Dias Úteis no Mês]
			VAR _diasMes   = COUNTROWS(DATESMTD('Date'[dt_referencia]))
			RETURN [NE | Visitas Planejadas] * DIVIDE(_diasUteis, IF(_diasMes = 0, 1, _diasMes))
		formatString: 0
		displayFolder: 07 - Feriados Natal RN\03 - Diagnóstico
		lineageTag: a146bc21-bdc3-4962-bc92-fd8f09f69f30

	/// Horas ideais ajustadas pela proporção de dias úteis reais no mês
	measure 'NE | Fer - Meta Horas Ajustada' =
			VAR _diasUteis = [NE | Fer - Dias Úteis no Mês]
			VAR _diasMes   = COUNTROWS(DATESMTD('Date'[dt_referencia]))
			RETURN [NE | Horas Ideais] * DIVIDE(_diasUteis, IF(_diasMes = 0, 1, _diasMes))
		formatString: 0.0
		displayFolder: 07 - Feriados Natal RN\03 - Diagnóstico
		lineageTag: 432bc93b-713b-43bb-aa01-6ebf9431dbcf

	measure 'Lojas Cadastradas (Rede)' = EXTERNALMEASURE("Lojas Cadastradas (Rede)", INTEGER, "DirectQuery para AS – Base Indicadores RG 2.0 - Projetos")
